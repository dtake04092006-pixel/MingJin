# Sao chép thành .env khi chạy thử trên máy (Render thì nhập trực tiếp trong dashboard).
# KHÔNG commit file .env.

DISCORD_TOKEN=dan_token_bot_vao_day
API_TOKEN=chuoi_bi_mat_tu_nghi_ra

# ID server Discord — có thì slash command hiện ngay, không có thì chờ tới 1 giờ
GUILD_ID=

# on / off : chế độ ảnh mặc định cho các kênh khai báo bằng CHANNELS
IMAGE_MODE=on

# (tuỳ chọn) kênh mặc định, cách nhau dấu phẩy: 123456789012345678,987654321098765432
CHANNELS=

LOG_LEVEL=INFO
PORT=8080
